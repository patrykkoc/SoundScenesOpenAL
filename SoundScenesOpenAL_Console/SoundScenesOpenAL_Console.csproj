<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SoundScenesOpenAL_Library\SoundScenesOpenAL_Library.csproj" />
  </ItemGroup>

  <!-- Wspólne zasoby z ..\Resources; Link zachowuje układ Resources\... w katalogu wyjściowym -->
  <ItemGroup>
    <None Include="..\Resources\**\*.wav" Link="Resources\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Resources\Sceny\*.json" Link="Resources\Sceny\%(Filename)%(Extension)" CopyToOutputDirectory="Always" />
    <None Include="..\Resources\openal32.dll" Link="openal32.dll" CopyToOutputDirectory="Always" />
  </ItemGroup>

</Project>
