<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Resources\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SoundScenesOpenAL_Library\SoundScenesOpenAL_Library.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Resources\**\*.wav" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Resources\openal32.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	<TargetPath>openal32.dll</TargetPath>
    </None>
    <None Update="Resources\Sceny\*.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
